{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/context-package-check.cjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/context-package-check.cjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "timeout": 15,
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/context-history.cjs\"",
            "type": "command"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/context-package-check.cjs\"",
            "timeout": 3
          }
        ]
      },
      {
        "hooks": [
          {
            "timeout": 3,
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/context-history.cjs\"",
            "type": "command"
          }
        ]
      }
    ],
    "PostModelRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/context-usage.cjs\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "timeout": 3,
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/context-history.cjs\"",
            "type": "command"
          }
        ]
      }
    ]
  }
}
